#!/usr/bin/env python3
"""
slopcheck — scan built output for AI-slop signatures.

Part of the design-antislop skill. Reads signatures.json (next to this file by
default) and flags the generic, machine-made tells across visual / UX / copy /
code so they can be fixed before shipping.

  slopcheck                     # scan cwd, medium+ severity, low-noise
  slopcheck src/ index.html     # scan specific paths
  slopcheck --strict            # include high-false-positive + prose-in-components
  slopcheck --min-severity high # only the near-certain tells
  slopcheck --dimension copy    # one dimension
  slopcheck --json              # machine output
  slopcheck --list              # show the loaded ruleset and exit
  slopcheck --include-nonshipped  # also scan tests/examples/fixtures structurally

Structural rules (visual / ux / code) are skipped inside tests, fixtures,
examples and docs, where they measure the test rather than the product.
Copy rules still run there.

Four copy rules describe a cluster rather than a single hit and are evaluated
per paragraph or per file, one finding per window — see WINDOWS below.

Exit: 0 clean · 1 medium/low findings · 2 at least one high-severity finding.
Advisory by design — a nonzero exit is a signal for CI, not a hard block here.
"""
import argparse, json, os, re, sys

# The ignore marker is honored only when it stands alone as a leading comment,
# so a file that merely mentions the marker string is still scanned.
IGNORE_MARKER = re.compile(
    r"^\s*(?:<!--|#|//|/\*|;|--)\s*slopcheck-ignore-file\b", re.M
)

def display_path(path):
    """Relative when the file sits under the cwd, absolute otherwise."""
    rel = os.path.relpath(path)
    return path if rel.startswith(os.pardir) else rel


SEV = {"low": 0, "medium": 1, "high": 2}
SEV_NAME = {0: "LOW", 1: "MED", 2: "HIGH"}

DIM_EXT = {
    "visual": {"css", "scss", "less", "html", "htm", "jsx", "tsx", "vue", "svelte", "astro"},
    "ux":     {"html", "htm", "jsx", "tsx", "vue", "svelte", "astro"},
    "copy":   {"md", "mdx", "markdown", "txt", "html", "htm"},
    "code":   {"js", "jsx", "ts", "tsx", "mjs", "cjs", "py", "go", "rs", "java",
               "rb", "php", "c", "h", "hpp", "cpp", "cc", "cs", "swift", "kt", "vue", "svelte"},
}
COPY_STRICT_EXTRA = {"jsx", "tsx", "vue", "svelte", "astro"}
IGNORE_DIRS = {"node_modules", ".git", "dist", "build", ".svelte-kit", ".next", ".nuxt",
               "out", "target", "vendor", ".venv", "venv", "__pycache__", "coverage",
               ".turbo", ".cache", ".vercel", ".output", ".astro"}

# Directories holding work that is never shipped to anyone: tests, fixtures,
# examples, docs. The structural dimensions are close to meaningless there —
# a placeholder in an example file *is* the example, and a fixture is supposed
# to look wrong. Copy rules are exempt, because a repeated writing tic in a
# draft is live prose and still worth catching.
NONSHIPPED_DIRS = {"test", "tests", "__tests__", "spec", "specs",
                   "fixture", "fixtures", "example", "examples",
                   "sample", "samples", "demo", "demos", "stories",
                   "snapshot", "snapshots", "doc", "docs"}
NONSHIPPED_EXEMPT_DIMS = {"copy"}
REGEXY = {"regex", "heuristic"}
MAX_BYTES = 2_000_000
MAX_HITS_PER_SIG = 8

# Three rules describe a cluster, not a single hit: "more than 2 em dashes
# within a single paragraph", "2+ distinct terms cluster in the same paragraph",
# "repeats 3+ times consecutively in the same list". None of that logic existed —
# each fired on the first lone match, and copy-em-dash-density counted per LINE,
# so nine em dashes one-per-line stayed silent while three on one line tripped it.
#
# The windows live here rather than in signatures.json on purpose. That file is
# regenerated from the research pipeline, and a regeneration that dropped a
# window would quietly turn a cluster rule back into a single-hit rule — exactly
# the bug this fixes. A rule's pattern is research; how its hits are grouped is
# scanner behaviour.
PARA_SPLIT = re.compile(r"\n[ \t]*\n")
WORD = re.compile(r"[A-Za-z0-9'\u2019-]+")
_SUFFIX = ("ing", "ed", "es", "s", "d")

# Em dashes, prose only. Markdown leans on the em dash as a *structural*
# separator: "- **Label** - definition", table cells, checklist "claim - verdict",
# link titles someone else wrote. That is ordinary formatting, not the authorship
# tic the rule is after, and counting every dash flags it by the hundred. On a
# 14-file hand sample, counting only mid-sentence asides moved this rule from the
# panel's measured 37.5% to 7 of 14, with volume down from 145 findings to 46.
_SKIP_LINE = re.compile(r"^\s*(?:\||#{1,6}\s|>)")
_MD_LINK = re.compile(r"\[[^\]]*\]\([^)]*\)")
_CODE_SPAN = re.compile(r"`[^`]*`")
_HTML_TAG = re.compile(r"<[^>]+>")
_LEAD = re.compile(r"^\s*(?:([-*+]|\d+[.)]|\(\d+\))\s+)?(.*?)\u2014")
_SENT_END = re.compile(r"[.!?][\"')\]]?(?:\s|$)")
_LABEL_END = ("**", "`", ")", "_", "*", '"', "\u201d", "\u2019", "'", ":")


_SCRIPTY = re.compile(r"<(script|style)\b[^>]*>.*?</\1>|<!--.*?-->", re.S | re.I)


def mask_code(text):
    """Blank out script, style and comment bodies, preserving offsets and lines.

    None of it is prose anyone reads, and all of it is full of em dashes used as
    separators: JS placeholder strings, design-token comment blocks.
    """
    return _SCRIPTY.sub(lambda m: re.sub(r"[^\n]", " ", m.group(0)), text)


_LINK = re.compile(r"\[[^\]\n]*\]\([^)\n]*\)|https?://[^\s)>\]\"']+")

def mask_links(text):
    """Blank Markdown links and bare URLs, preserving offsets and lines.

    A link title is usually someone else's headline and a slug is nobody's
    prose. Two of the four promotional-verb findings in the September 2026
    blind audit were the word "empower" inside a press-release URL.
    """
    return _LINK.sub(lambda m: " " * len(m.group(0)), text)

def prose_em_dashes(para):
    """Count em dashes used as sentence asides, not as Markdown structure."""
    n = 0
    fenced = False
    for raw in para.split("\n"):
        if raw.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced or _SKIP_LINE.match(raw):
            continue
        tagged = _HTML_TAG.search(raw) is not None
        line = _HTML_TAG.sub(" ", _CODE_SPAN.sub(" ", _MD_LINK.sub(" ", raw)))
        d = line.count("\u2014")
        if not d:
            continue
        # A short run of text inside markup is a UI label, not a sentence:
        # "<option>Site 04 - Kilimanjaro Ridge</option>".
        if tagged and len(WORD.findall(line)) < 12:
            continue
        m = _LEAD.match(line)
        if m:
            bullet, lead = m.group(1), m.group(2).rstrip()
            # Only a list item or an emphasis-terminated label reads as structure.
            # A bare prose line keeps its dash, so "It is not just fast - it is
            # elegant" still counts as the aside it is.
            if (bullet or lead.endswith(_LABEL_END)) and not _SENT_END.search(lead):
                d -= 1
        n += d
    return n


WINDOWS = {
    # Density, not a raw count: hard-wrapped prose and one-line paragraphs must
    # score the same. 2.0 per 100 words is the 25th percentile of the paragraphs
    # the per-line version was already firing on, so this reproduces the rule's
    # own operating point instead of inventing a threshold. One finding per file,
    # because the fix is "rewrite your dashes", done once per document.
    "copy-em-dash-density": {"kind": "density", "count": prose_em_dashes,
                             "min_count": 3, "per_100_words": 2.0, "max_per_file": 1,
                             "mask": mask_code},
    "copy-vocabulary-tier2": {"kind": "distinct", "min": 2},
    "copy-rule-of-three-bold-bullets": {"kind": "count", "min": 3},
    # One "it is not X, it is Y" is a choice; the blind audit's graders only
    # called it a tic when it recurred in the same document. Two graders split
    # on 7 of 18 single instances, and every split was a repeat-in-file case.
    "copy-binary-contrast": {"kind": "file", "min": 2},
}


def paragraphs(content):
    """Yield (offset, text) for each blank-line-delimited block."""
    pos = 0
    for m in PARA_SPLIT.finditer(content):
        if m.start() > pos:
            yield pos, content[pos:m.start()]
        pos = m.end()
    if pos < len(content):
        yield pos, content[pos:]


def stem(word):
    """Fold inflections so empower/empowers/empowering count as one term."""
    w = word.lower()
    for suf in _SUFFIX:
        if w.endswith(suf) and len(w) - len(suf) >= 4:
            w = w[:-len(suf)]
            break
    return w.rstrip("e") or w


def load_signatures(path):
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    sigs = data.get("signatures", data) if isinstance(data, dict) else data
    out = []
    for s in sigs:
        mt = (s.get("match_type") or "regex").lower()
        pat = s.get("match") or ""
        s = dict(s)
        if mt in REGEXY:
            try:
                s["_re"] = re.compile(pat, re.MULTILINE | re.IGNORECASE)
                s["_kind"] = "regex"
            except re.error:
                s["_kind"] = "literal"
                s["_lit"] = pat.lower()
        else:
            s["_kind"] = "literal"
            s["_lit"] = pat.lower()
        out.append(s)
    return out


def find_in(content, sig):
    """Hits for a signature: one per match, or one per qualifying window."""
    if sig.get("dimension") == "copy":
        content = mask_links(content)
    spec = WINDOWS.get(sig.get("id"))
    if spec and spec["kind"] == "file":
        return find_in_file(content, sig, spec)
    if spec:
        return find_windowed(content, sig, spec)
    return raw_hits(content, sig, MAX_HITS_PER_SIG)


def find_in_file(content, sig, spec):
    """A rule that is only a tic in repetition: one hit per file, anchored at
    the first instance, and the reported text says how many there were."""
    ms = raw_hits(content, sig, 0)
    if len(ms) < spec["min"]:
        return []
    return [(ms[0][0], "%d in file: %s" % (len(ms), ms[0][1]))]


def find_windowed(content, sig, spec):
    """Evaluate a cluster rule per paragraph, at most one hit per paragraph.

    The hit is anchored at the first match in the window so the reported line
    points at the start of the cluster, and the reported text is the paragraph
    itself, which is what a human needs to judge whether the cluster is real.
    """
    hits, ranked = [], []
    mask = spec.get("mask")
    for base, para in paragraphs(mask(content) if mask else content):
        if spec["kind"] == "density":
            n = spec["count"](para)
            if n < spec["min_count"]:
                continue
            words = len(WORD.findall(para))
            rate = n * 100.0 / words if words else 0.0
            if words and rate < spec["per_100_words"]:
                continue
            dash = para.find("\u2014")
            ranked.append((rate, base + (dash if dash >= 0 else 0), para))
        else:
            ms = raw_hits(para, sig, 0)
            if not ms:
                continue
            n = len({stem(t) for _, t in ms}) if spec["kind"] == "distinct" else len(ms)
            if n < spec["min"]:
                continue
            hits.append((base + ms[0][0], para))
        if len(hits) >= MAX_HITS_PER_SIG:
            break
    if ranked:                      # densest paragraphs first, capped per file
        ranked.sort(key=lambda r: -r[0])
        hits = [(pos, para) for _, pos, para in ranked[:spec.get("max_per_file", MAX_HITS_PER_SIG)]]
    return hits


def raw_hits(content, sig, limit):
    """Every match of the signature. limit=0 means no cap."""
    hits = []
    if sig["_kind"] == "regex":
        for m in sig["_re"].finditer(content):
            hits.append((m.start(), m.group(0)))
            if limit and len(hits) >= limit:
                break
    else:
        lit = sig.get("_lit", "")
        if not lit:
            return hits
        low = content.lower()
        start = 0
        while True:
            i = low.find(lit, start)
            if i < 0:
                break
            hits.append((i, content[i:i + len(lit)]))
            if limit and len(hits) >= limit:
                break
            start = i + len(lit)
    return hits


def snippet(text):
    return re.sub(r"\s+", " ", text).strip()[:90]


def in_nonshipped(path, base):
    """True when a directory between `base` and the file is a non-shipped surface.

    Only the components below the scanned root count. A project that happens to
    live under a directory called docs/ or test/ is still scanned normally; it
    is the structure *inside* what you pointed at that decides.
    """
    try:
        rel = os.path.relpath(path, base) if base else path
    except ValueError:          # different drives on Windows
        rel = path
    parts = os.path.normpath(rel).split(os.sep)[:-1]
    return any(p.lower() in NONSHIPPED_DIRS for p in parts)


def iter_files(paths):
    """Yield (path, base) so callers can judge a file by its position under base."""
    for p in paths:
        if os.path.isfile(p):
            # Named directly: judge it by the path the caller wrote, so the hook
            # still skips a file it was handed from inside examples/.
            yield p, ""
        elif os.path.isdir(p):
            for root, dirs, names in os.walk(p):
                dirs[:] = [d for d in dirs if d not in IGNORE_DIRS and not d.startswith(".")]
                for n in names:
                    yield os.path.join(root, n), p


def main():
    here = os.path.dirname(os.path.abspath(__file__))
    ap = argparse.ArgumentParser(prog="slopcheck", add_help=True,
                                 description="Scan built output for AI-slop signatures. Exit codes: 0 clean, 1 findings below high, 2 at least one high-severity finding, 3 signatures file unreadable.")
    ap.add_argument("paths", nargs="*", default=["."], help="files or dirs (default: .)")
    ap.add_argument("--signatures", default=os.path.join(here, "signatures.json"),
                    help="ruleset file to load (default: the bundled signatures.json)")
    ap.add_argument("--min-severity", choices=list(SEV), default="medium",
                    help="lowest severity to report (default: medium)")
    ap.add_argument("--strict", action="store_true",
                    help="include high-false-positive rules + scan prose inside components")
    ap.add_argument("--dimension", default="",
                    help="comma list to restrict: visual,ux,copy,code")
    ap.add_argument("--json", action="store_true",
                    help="emit scanned/findings/summary as JSON")
    ap.add_argument("--quiet", action="store_true", help="summary line only")
    ap.add_argument("--no-color", action="store_true",
                    help="drop ANSI codes, for logs and CI")
    ap.add_argument("--include-nonshipped", action="store_true",
                    help="also apply structural rules inside tests/, examples/, fixtures/, docs/")
    ap.add_argument("--list", action="store_true", help="print the active ruleset and exit")
    args = ap.parse_args()

    try:
        sigs = load_signatures(args.signatures)
    except FileNotFoundError:
        print(f"slopcheck: signatures file not found: {args.signatures}", file=sys.stderr)
        return 3

    min_sev = SEV[args.min_severity]
    dims_filter = {d.strip() for d in args.dimension.split(",") if d.strip()}
    active = []
    for s in sigs:
        if SEV.get(s.get("severity", "low"), 0) < min_sev:
            continue
        if s.get("false_positive_risk") == "high" and not args.strict:
            continue
        if dims_filter and s.get("dimension") not in dims_filter:
            continue
        active.append(s)

    ext_map = {d: set(v) for d, v in DIM_EXT.items()}
    if args.strict:
        ext_map["copy"] |= COPY_STRICT_EXTRA

    use_color = sys.stdout.isatty() and not args.no_color
    def c(code, txt):
        return f"\033[{code}m{txt}\033[0m" if use_color else txt

    if args.list:
        for s in sorted(active, key=lambda x: (x.get("dimension", ""), -SEV.get(x.get("severity", "low"), 0))):
            print(f"{s.get('dimension','?'):7} {SEV_NAME[SEV.get(s.get('severity','low'),0)]:4} "
                  f"fp:{(s.get('false_positive_risk','?') or '?')[:3]:3} {s.get('id','?')}")
        print(f"\n{len(active)} active of {len(sigs)} signatures "
              f"(min-severity={args.min_severity}, strict={args.strict}).")
        return 0

    findings = []
    scanned = 0
    for path, base in iter_files(args.paths):
        ext = path.rsplit(".", 1)[-1].lower() if "." in os.path.basename(path) else ""
        if ".min." in os.path.basename(path):
            continue
        applic = {d for d, exts in ext_map.items() if ext in exts}
        if not args.include_nonshipped and in_nonshipped(path, base):
            applic &= NONSHIPPED_EXEMPT_DIMS
        if not applic:
            continue
        try:
            if os.path.getsize(path) > MAX_BYTES:
                continue
            with open(path, "rb") as fh:
                head = fh.read(4096)
            if b"\x00" in head:
                continue
            with open(path, encoding="utf-8", errors="ignore") as fh:
                content = fh.read()
        except OSError:
            continue
        if IGNORE_MARKER.search(content[:2048]):
            continue
        scanned += 1
        for s in active:
            if s.get("dimension") not in applic:
                continue
            for pos, txt in find_in(content, s):
                findings.append({
                    "file": display_path(path),
                    "line": content.count("\n", 0, pos) + 1,
                    "id": s.get("id"),
                    "dimension": s.get("dimension"),
                    "severity": s.get("severity", "low"),
                    "false_positive_risk": s.get("false_positive_risk"),
                    "match": snippet(txt),
                    "fix": s.get("fix", ""),
                })

    highs = sum(1 for f in findings if f["severity"] == "high")
    meds = sum(1 for f in findings if f["severity"] == "medium")
    lows = sum(1 for f in findings if f["severity"] == "low")

    if args.json:
        json.dump({"scanned": scanned,
                   "summary": {"high": highs, "medium": meds, "low": lows, "total": len(findings)},
                   "findings": findings}, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return 2 if highs else (1 if findings else 0)

    if not findings:
        if not args.quiet:
            fnoun = "file" if scanned == 1 else "files"
            print(c("32", f"✓ slopcheck: clean ({scanned} {fnoun}, no {args.min_severity}+ slop)."))
        return 0

    if not args.quiet:
        by_file = {}
        for f in findings:
            by_file.setdefault(f["file"], []).append(f)
        rank = {"high": 0, "medium": 1, "low": 2}
        for fname in sorted(by_file):
            print("\n" + c("1;4", fname))
            for f in sorted(by_file[fname], key=lambda x: (rank[x["severity"]], x["line"])):
                tag = {"high": c("1;31", "HIGH"), "medium": c("33", "MED "), "low": c("2", "LOW ")}[f["severity"]]
                print(f"  {tag}  {f['id']}  {c('2', 'L'+str(f['line']))}")
                print(f"        {c('2','“'+f['match']+'”')}")
                if f["fix"]:
                    print(f"        {c('36','→ '+snippet(f['fix']))}")

    total = len(findings)
    bar = c("1;31", f"{highs} high") + ", " + c("33", f"{meds} medium") + ", " + f"{lows} low"
    noun = "finding" if total == 1 else "findings"
    fnoun = "file" if scanned == 1 else "files"
    print("\n" + c("1", f"slopcheck: {total} {noun} ({bar}) across {scanned} {fnoun}."))
    if not args.strict:
        print(c("2", "  (medium+ shown; high-false-positive rules hidden — add --strict for the full sweep)"))
    return 2 if highs else 1


if __name__ == "__main__":
    sys.exit(main())
